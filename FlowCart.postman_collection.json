{
  "info": {
    "_postman_id": "b34df612-4f70-4cb6-bb7e-40549c4d9220",
    "name": "FlowCart Microservices API",
    "description": "Postman Collection for testing FlowCart Microservices through YARP API Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "sampleProductId",
      "value": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
      "type": "string"
    },
    {
      "key": "createdOrderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Gateway",
      "item": [
        {
          "name": "Discovery & Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        }
      ]
    },
    {
      "name": "Catalog Service",
      "item": [
        {
          "name": "Get Products (Paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Product By Id (Redis Cache-Aside)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{sampleProductId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{sampleProductId}}"]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"4K Ultra-Wide Monitor 34-inch\",\n  \"description\": \"Curved HDR display for productivity and gaming\",\n  \"sku\": \"MON-UW-34\",\n  \"price\": 799.99,\n  \"currency\": \"USD\",\n  \"categoryId\": \"11111111-1111-1111-1111-111111111111\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        }
      ]
    },
    {
      "name": "Inventory Service",
      "item": [
        {
