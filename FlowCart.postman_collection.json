              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "products", "{{sampleProductId}}"]
            }
          }
        },
        {
          "name": "Reserve Stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{sampleProductId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inventory/reserve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "reserve"]
            }
          }
        },
        {
          "name": "Release Stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{sampleProductId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/inventory/release",
              "host": ["{{baseUrl}}"],
              "path": ["api", "inventory", "release"]
            }
          }
        }
      ]
    },
    {
      "name": "Ordering Service",
      "item": [
        {
          "name": "Checkout / Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('createdOrderId', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"shippingAddress\": {\n    \"street\": \"123 Tech Way\",\n    \"city\": \"San Francisco\",\n    \"state\": \"CA\",\n    \"country\": \"USA\",\n    \"zipCode\": \"94107\"\n  },\n  \"items\": [\n    {\n      \"productId\": \"{{sampleProductId}}\",\n      \"productName\": \"Enterprise Dev Laptop 16-inch\",\n      \"expectedUnitPrice\": 1999.99,\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get Orders (Paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Order By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{createdOrderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{createdOrderId}}"]
            }
          }
        },
        {
          "name": "Confirm Order",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{createdOrderId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{createdOrderId}}", "confirm"]
            }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Item ordered by mistake\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{createdOrderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{createdOrderId}}", "cancel"]
            }
          }
        }
      ]
    }
  ]
